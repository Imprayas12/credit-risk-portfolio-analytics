# Copy this file to .env and fill in your key, or set it as a secret
# in your hosting platform (Streamlit Community Cloud -> Settings -> Secrets).
#
# If OPENAI_API_KEY is not set, the "Ask the Portfolio" feature falls back
# to a deterministic rule-based query engine over the same grounded data
# (no LLM text generation, but still answers from real numbers).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
